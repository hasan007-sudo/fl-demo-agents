OPIK_API_KEY=
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=livekit-agents
# For self-hosted: OPIK_HOST=http://localhost:5173

# Langfuse Observability (legacy - optional)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://us.cloud.langfuse.com